# ============================================================
# WhatsCRM v5.9.5 - Git Ignore File
# Prevents sensitive and unnecessary files from being committed
# ============================================================

# ─── CRITICAL: Environment & Secrets ────────────────────────
# NEVER commit these files - they contain passwords and API keys
.env
.env.*
.env.local
.env.production
.env.development
.env.test
.env.backup
*.env

# ─── Dependencies ────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Keep package-lock.json for production consistency
# Uncomment below if you want to ignore it
# package-lock.json
yarn.lock
pnpm-lock.yaml

# ─── Media & Uploads ─────────────────────────────────────────
# User uploaded files (media, documents, images)
client/public/media/*
!client/public/media/.gitkeep
client/public/meta-media/*
!client/public/meta-media/.gitkeep

# Telegram uploads (may have long filenames)
client/public/telegram/

# QR codes and session data
qr-codes/
sessions/
*.session.json

# ─── Database ────────────────────────────────────────────────
# Database dumps and backups
*.sql.backup
*.sql.bak
backup_*.sql
*_backup.sql
database_backup/
backups/

# Database files (SQLite, if used)
*.sqlite
*.sqlite3
*.db

# ─── Logs ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
error.log
access.log
combined.log

# PM2 logs
pm2-error.log
pm2-out.log
.pm2/

# ─── Operating System Files ──────────────────────────────────
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

