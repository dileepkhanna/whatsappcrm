coverage/
.nyc_output/
*.test.js.snap

# Playwright
playwright-report/
playwright/.cache/

# ─── Build & Distribution ────────────────────────────────────
dist/
build/
.next/
.nuxt/

# ─── Temporary Files ─────────────────────────────────────────
tmp/
temp/
*.tmp
*.temp
.cache/

# ─── SSL Certificates & SSH Keys ─────────────────────────────
# NEVER commit private keys or certificates
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
ssl/
certs/

# AWS EC2 Key Pairs - CRITICAL!
ec2.pem
*.pem
*-key-pair.pem
*-keypair.pem
aws-*.pem
lightsail-*.pem

# SSH Keys
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.ppk
known_hosts

# AWS Credentials
.aws/
*.aws/credentials
.boto
credentials.json
service-account.json

# Other cloud provider keys
.gcp/
.azure/

# ─── Configuration Backups ───────────────────────────────────
config.backup
*.config.backup
settings.backup

# ─── WhatsApp Session Data ───────────────────────────────────
# Baileys session files - CRITICAL: Contains WhatsApp auth tokens
*.session
session-*/
auth_info.json
auth_info_baileys/
auth_info_baileys/*
creds.json
!auth_info_baileys/.gitkeep

# ─── MongoDB ─────────────────────────────────────────────────
# MongoDB dump files
dump/
mongodump/

# ─── Redis ───────────────────────────────────────────────────
dump.rdb
appendonly.aof

# ─── NPM/Yarn Cache ──────────────────────────────────────────
.npm/
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# ─── Optional: Large Files ───────────────────────────────────
# Uncomment if you want to exclude large files
# *.mp4
# *.mov
# *.avi
# *.zip
# *.tar.gz
# *.rar

# ASE Technologies - Keep logo files
!client/public/assets/ase_logo.png
!client/public/media/ase_logo.png
!client/public/favicon.ico
!client/public/logo192.png
!client/public/logo512.png
!client/public/apple-touch-icon.png

# ─── Database Migrations ─────────────────────────────────────
# IMPORTANT: DO commit migration files - they are version controlled!
# migrations/*.js  <- DO NOT IGNORE THESE
# config/database.js  <- DO NOT IGNORE THIS

# ─── Custom Exclusions ───────────────────────────────────────
# Test and helper scripts (after cleanup)
test-*.js
test-*.html
test_*.js
check-*.js
check_*.sql
fix-*.js
fix_*.sql
fix-*.html
debug-*.js
diagnose-*.js
diagnose_*.sql
*-test.js
*-debug.js
*-fix.js

# Backup files from editors
*.bak
*.orig

# Documentation drafts (if you use)
# drafts/
# notes.txt

# Local development scripts
local-*.sh
local-*.bat
restart-*.ps1
!restart-server.ps1

# Personal notes and TODOs
TODO.md
NOTES.md
.todo

# Cleanup summaries (optional - uncomment if you don't want to commit)
# CLEANUP_SUMMARY.md

# Old/backup documentation
*_OLD.md
*_BACKUP.md
*.md.bak

# ─── Keep These Files (Force Include) ────────────────────────
# Use ! to force include important files even if parent folder is ignored

# Keep .gitkeep files to preserve empty directories
!**/.gitkeep

# Keep example/template files
!.env.example
!config.example.js

# Keep important documentation
!README.md
!LICENSE
!CHANGELOG.md

# ============================================================
# IMPORTANT NOTES:
# ============================================================
# 1. If .env is already committed, remove it:
#    git rm --cached .env
#    git commit -m "Remove .env from version control"
#
# 2. Create .env.example with dummy values:
#    cp .env .env.example
#    # Then edit .env.example to remove sensitive data
#
# 3. Check what will be committed:
#    git status
#
# 4. Test .gitignore:
#    git check-ignore -v filename
#
# 5. If you accidentally commit sensitive files:
#    - Remove from Git: git rm --cached filename
#    - Consider the data compromised
#    - Rotate all secrets immediately
#    - Use git-filter-repo or BFG to clean history
# ============================================================

# ─── Kiro AI Assistant ───────────────────────────────────────
# Kiro configuration and settings
.kiro/
.kiro/*
!.kiro/.gitkeep

# Keep steering files and specs if you want to version control them
!.kiro/steering/
!.kiro/specs/
!.kiro/skills/

# ============================================================
# END OF .gitignore
