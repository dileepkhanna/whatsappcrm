# ============================================================
# WhatsCRM v5.9.5 - Environment Configuration Template
# ============================================================
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values in the .env file
# 3. NEVER commit the .env file to Git
# ============================================================

# ─── Server ──────────────────────────────────────────────────
PORT=3010

# ─── Database (MySQL) ────────────────────────────────────────
DBHOST=localhost
DBPORT=3306
DBUSER=your_mysql_user
DBPASS=your_mysql_password
DBNAME=whatscrm

# ─── JWT Secret ──────────────────────────────────────────────
# CRITICAL: Generate a strong random string for production
# Example: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWTKEY=change-this-to-a-long-random-string-in-production

# ─── App URLs ────────────────────────────────────────────────
# FRONTENDURI: Public URL where the app is accessible
# BACKURI: Backend URL (used for payment callbacks)
# For production, use your actual domain with HTTPS
FRONTENDURI=http://localhost:3010
BACKURI=http://localhost:3010

# ─── Stripe ──────────────────────────────────────────────────
# Set from Admin Panel → Payment Gateway
STRIPE_LANG=en

# ─── Node Environment ────────────────────────────────────────
# Options: development, production
NODE_ENV=development

# ============================================================
# NOTE: The following are configured via Admin Panel UI
# and stored in the database (web_private table)
# ============================================================
# - Payment gateway credentials (Stripe, Razorpay, PayPal, etc.)
# - WhatsApp Meta Cloud API credentials
# - Firebase/FCM push notification credentials
# - AI service API keys (Gemini, ElevenLabs)
# - Social media integration (Telegram, Instagram)
# - SMTP email configuration
# - MongoDB connection (optional, for session storage)
# ============================================================

# ─── Production Checklist ────────────────────────────────────
# Before deploying to production:
# [ ] Change JWTKEY to a strong random string
# [ ] Update FRONTENDURI and BACKURI to your domain (HTTPS)
# [ ] Set NODE_ENV=production
# [ ] Use a dedicated MySQL user (not root)
# [ ] Change default admin password
# [ ] Enable HTTPS with SSL certificate
# [ ] Configure firewall rules
# [ ] Setup automated backups
# ============================================================
